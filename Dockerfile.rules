# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 golang:1.26-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN mkdir -p /out && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/rules ./cmd/rules
RUN ls -la /out/rules

FROM --platform=linux/amd64 alpine:3.20
RUN adduser -D -u 10001 appuser
COPY --from=build --chmod=755 /out/rules /usr/local/bin/rules
USER appuser

EXPOSE 50051
ENTRYPOINT ["rules"]